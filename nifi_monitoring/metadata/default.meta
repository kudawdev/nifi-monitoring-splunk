
# Application-level permissions

[]
access = read : [ * ], write : [ admin, power ]

### EVENT TYPES

[eventtypes]
export = system


### PROPS

[props]
export = system


### TRANSFORMS

[transforms]
export = system


### LOOKUPS

[lookups]
export = system


### VIEWSTATES: even normal users should be able to create shared viewstates

[viewstates]
access = read : [ * ], write : [ * ]
export = system


### MACROS
# The NIFI datamodel is exported to system and its constraints all go through
# the index_nifi macro, so the macro has to be visible wherever the datamodel
# is. Without this the model resolves to nothing outside this app -- which is
# the whole point of exporting it -- and its acceleration searches cannot
# resolve the macro either.

[macros]
export = system


### DATAMODELS

[datamodels/NIFI]
access = read : [ * ], write : [ admin, power, sc_admin ]
export = system

[models/NIFI]
access = read : [ * ], write : [ admin, power, sc_admin ]
export = system
