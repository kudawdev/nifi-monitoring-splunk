<form refresh="60" version="1.1" hideEdit="true">
  <label>Nifi TA Monitoring</label>
  <fieldset submitButton="true" autoRun="false">
    <input type="time" token="time">
      <label>Time</label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="dropdown" token="severity">
      <label>Severity</label>
      <choice value="INFO">INFO</choice>
      <choice value="ERROR">ERROR</choice>
      <choice value="">ALL</choice>
      <default></default>
    </input>
    <input type="dropdown" token="span">
      <label>Time Span</label>
      <choice value="1min">1 minute</choice>
      <choice value="5min">5 minutes</choice>
      <choice value="10min">10 minutes</choice>
      <default>5min</default>
      <initialValue>5min</initialValue>
    </input>
    <input type="text" token="search">
      <label>Search</label>
      <default>*</default>
      <initialValue>*</initialValue>
    </input>
  </fieldset>
  <row>
    <panel>
      <title>Configuration</title>
      <single>
        <title>Events the app can see (index_nifi macro)</title>
        <search>
          <query>| tstats count where `index_nifi` sourcetype=nifi:* by sourcetype
| stats sum(count) as events, dc(sourcetype) as sourcetypes</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="field">events</option>
        <option name="rangeColors">["0xD32F2F","0x4CAF50"]</option>
        <option name="rangeValues">[0]</option>
        <option name="underLabel">zero means the macro points at the wrong index</option>
        <option name="useColors">1</option>
        <option name="refresh.display">progressbar</option>
      </single>
    </panel>
    <panel>
      <title>Where NiFi data actually is</title>
      <table>
        <title>Set the index_nifi macro to whichever index this lists</title>
        <search>
          <!-- The one place index=* is the right thing to do: this panel
               exists to find out where the data landed, it runs only when
               someone opens this page, and tstats reads index-time metadata
               rather than scanning events. -->
          <query>| tstats count where index=* sourcetype=nifi:* by index, sourcetype
| stats sum(count) as events, values(sourcetype) as sourcetypes by index
| sort - events</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
        <option name="wrap">false</option>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Collection</title>
      <table>
        <title>NiFi version and collection path per instance</title>
        <search>
          <query>| tstats latest(_time) as last_seen where `index_nifi` sourcetype=nifi:* by host, sourcetype
| eval path = case(
    like(sourcetype, "nifi:api:%"), "REST pull (TA modular input)",
    like(sourcetype, "nifi:reporting:%"), "HEC push (reporting task)",
    like(sourcetype, "nifi:log:%"), "log file",
    1==1, sourcetype)
| stats latest(last_seen) as last_seen, values(path) as paths by host
| join type=left host
    [| tstats latest(niFiVersion) as nifi_version, latest(javaVersion) as java_version
         where `index_nifi` sourcetype="nifi:api:version_info" by host]
| eval last_seen = strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table host, nifi_version, java_version, paths, last_seen
| sort host</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
        <option name="wrap">false</option>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>HTTP Status Response</title>
        <search>
          <query>index=_internal "nifi log"  "status_code"
| rex "status_code: (?P&lt;status_code&gt;\d+)"
| eval status = case(status_code == 200, "OK", status_code IN (404), "ERROR", 1==1, "No Aplica")
| search status IN ("OK", "ERROR")
| timechart span=$span$ count by status</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.drilldown">none</option>
        <option name="charting.fieldColors">{"ERROR": 0xD32F2F, "OK": 0x4CAF50}</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <event>
        <search>
          <query>index=_internal "nifi log" $severity$ $search$</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="list.drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </event>
    </panel>
  </row>
</form>