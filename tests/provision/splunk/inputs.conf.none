# TA input for the unsecured NiFi profile.
[nifi://nifi]
api_url = http://nifi:8080/nifi-api/
auth_type = none
endpoint_flow_status = 1
endpoint_system_diagnostics = 1

# Exercised by the harness so the flattening runs against a real payload.
# Off by default in the shipped app: see the volume note in inputs.conf.spec.
endpoint_flow_metrics = 1
metrics_strategy = ALL_COMPONENTS
host = nifi
index = main
interval = 60
