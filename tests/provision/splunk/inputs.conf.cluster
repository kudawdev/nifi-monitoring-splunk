# TA input for the cluster profile.
#
# The NiFi is unsecured, like the push profile's, but here the modular input
# is the collector: the point is to prove the add-on reads a cluster, so it
# has to be the one doing the reading.
#
# Nothing here asks for cluster data. The add-on detects that NiFi is
# clustered from /flow/cluster/summary and collects the per-node sourcetypes
# on its own -- an operator should not have to know, and this input is the
# assertion that they do not.

[nifi://nifi]
api_url = http://nifi:8080/nifi-api/
auth_type = none

endpoint_flow_status = 1
endpoint_system_diagnostics = 1

# Same as the other pull profiles, and on a cluster it also exercises the
# CLUSTER registry, which until now was offered as an input option that nobody
# had ever pointed at a cluster.
endpoint_flow_metrics = 1
metrics_strategy = ALL_COMPONENTS
# Two custom endpoints, one that works and one that cannot: the point is
# that the second writes nothing at all (defect CE-1). Before the fix it
# produced one event per poll carrying the 404 body, under this very
# sourcetype, so the index said the endpoint was fine.
#
# Named, not given a sourcetype: each lands under
# nifi:api:custom:<name>, which is also the only thing keeping a
# custom endpoint out of the add-on's own namespace (CE-5).
#
# One per line, continued with a trailing backslash. The UI textarea
# accepts a plain newline, but a hand-written .conf does not: Splunk
# ends the value at the first unescaped newline and silently drops the
# rest, indented or not. Verified with btool against this very file.
custom_endpoints = cluster,/controller/cluster\
missing,/flow/controller/status/history

host = nifi
index = nifi
interval = 60
