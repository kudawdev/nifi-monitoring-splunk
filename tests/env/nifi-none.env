# NiFi with no authentication, plain HTTP.
#
# Works out of the box on NiFi 1.x. On NiFi 2.x the container's start.sh
# applies the container hostname to the HTTPS host, which takes precedence
# over any HTTP setting, so an unsecured 2.x instance needs the HTTPS
# properties blanked as well. Verified against 1.23.2; for 2.x prefer the
# singleuser profile, which is also what a real deployment looks like.
NIFI_WEB_HTTP_HOST=0.0.0.0
NIFI_WEB_HTTP_PORT=8080
NIFI_WEB_HTTPS_HOST=
NIFI_WEB_HTTPS_PORT=
