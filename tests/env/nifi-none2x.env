# NiFi 2.x on plain HTTP with no authentication.
#
# Needs the replacement entrypoint in provision/nifi/start-unsecured.sh: the
# image's own start.sh writes nifi.web.https.port from ${VAR:-8443}, and that
# substitutes the default for an empty value too, so no environment variable
# can clear it and NiFi always comes up on HTTPS.
#
# The push path requires this: the flow calls its own REST API with no
# credentials, so an authenticated NiFi rejects it.
NIFI_WEB_HTTP_HOST=0.0.0.0
NIFI_WEB_HTTP_PORT=8080
