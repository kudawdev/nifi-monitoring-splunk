# Second NiFi of the multi-instance push profile: unsecured, like the first.
#
# The push strategy requires it. The flow calls its own API with no
# credentials, so an authenticated NiFi rejects it -- which is why both
# instances of a push profile have to be unsecured, not just one.
NIFI_WEB_HTTP_HOST=0.0.0.0
NIFI_WEB_HTTP_PORT=8080
