# Second NiFi node for the multi-instance profile: an independent instance,
# NOT a cluster member. Same credentials as the first, different proxy hosts.
#
# This is the profile that exercises the TA's basic-auth path:
# POST /access/token against the single-user login identity provider.
NIFI_WEB_HTTPS_HOST=0.0.0.0
NIFI_WEB_HTTPS_PORT=8443
NIFI_SECURITY_USER_AUTHORIZER=single-user-authorizer
NIFI_SECURITY_USER_LOGIN_IDENTITY_PROVIDER=single-user-provider
NIFI_SECURITY_USER_AUTHORIZATION=single-user-authorizer

# NiFi rejects any request whose Host header it does not recognise with
# HTTP 421 Misdirected Request. Without this every API call fails, which is
# what the old harness hit: it shipped the literal placeholder
# '<URL_BASE>:9443'.
NIFI_WEB_PROXY_HOST=localhost:38444,localhost,nifi-b:8443,nifi-b

# Must be at least 12 characters. Shorter values are silently ignored and
# NiFi generates random credentials instead, which is what the old harness
# did with 'Password' (8 characters).
SINGLE_USER_CREDENTIALS_USERNAME=admin
SINGLE_USER_CREDENTIALS_PASSWORD=ctsBtRBKHRAx69EqUghvvgEvjnaLjFEB
